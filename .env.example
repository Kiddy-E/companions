# PostgreSQL connection string
DATABASE_URL="postgresql://companions:CHANGE_ME@db:5432/companions?schema=public"

# Session signing secret — generate with: openssl rand -hex 32
SESSION_SECRET="CHANGE_ME_min_32_chars_random_string"

# Directory for uploaded pet photos (mapped as docker volume)
UPLOAD_DIR="/data/uploads"

# Public app URL (used in PWA manifest and emails)
NEXT_PUBLIC_APP_URL="https://companions.yourdomain.com"

NODE_ENV="production"
